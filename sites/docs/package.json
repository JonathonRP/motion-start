{
	"name": "@motion-start/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bun run dev:content\" \"bun run dev:svelte\"",
		"dev:content": "velite dev --watch",
		"dev:svelte": "vite dev",
		"build": "velite && node ./scripts/update-velite-output.js && bun run build:search && vite build",
		"build:search": "node ./scripts/build-search-data.js",
		"preview": "vite preview",
		"check": "velite && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "velite && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"motion-start": "workspace:*"
	},
	"devDependencies": {
		"@svecodocs/kit": "^0.5.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.18.1",
		"concurrently": "^10.0.4",
		"mdsx": "^0.0.7",
		"phosphor-svelte": "^3.1.0",
		"remove-markdown": "^0.6.4",
		"svelte": "5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"velite": "^0.4.0",
		"vite": "^7.3.6"
	}
}
