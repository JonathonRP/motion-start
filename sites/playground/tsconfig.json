{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": ["node_modules", ".svelte-kit"]
}
