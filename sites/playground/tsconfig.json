{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"types": ["node", "cypress", "cypress-real-events"],
		"paths": {
			// Mirrors the vite alias: a few routes reach for library internals that
			// are deliberately not exported. Everything else imports "motion-start".
			"$lib/motion-start/*": ["../../packages/motion-start/src/lib/motion-start/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", ".svelte-kit"]
}
