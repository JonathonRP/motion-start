{
	"name": "motion-start-monorepo",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": "github:JonathonRP/motion-start",
	"workspaces": [
		"packages/*",
		"sites/*"
	],
	"scripts": {
		"build": "bun --cwd packages/motion-start run build",
		"package": "bun --cwd packages/motion-start run package",
		"check": "bun --cwd packages/motion-start run check",
		"test": "bun --cwd packages/motion-start run test",
		"test:run": "bun --cwd packages/motion-start run test:run",
		"test:types": "bun --cwd packages/motion-start run test:types",
		"dev": "bun --cwd sites/playground run dev",
		"cypress": "bun --cwd sites/playground run cypress",
		"docs:dev": "bun --cwd sites/docs run dev",
		"docs:build": "bun --cwd sites/docs run build",
		"lint": "biome check",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@changesets/cli": "^2.31.0",
		"@types/bun": "latest",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=20"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@sveltejs/kit",
		"@swc/core",
		"@tailwindcss/oxide",
		"cypress",
		"esbuild",
		"sharp",
		"svelte-preprocess",
		"workerd"
	]
}
